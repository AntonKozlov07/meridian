# Copy to .env and fill in. Never commit .env.

# Spotify (required) - https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# GetSongBPM (optional, BPM/key fallback) - https://getsongbpm.com/api
GETSONGBPM_API_KEY=

# Last.fm (optional, play counts, listeners, scrobbling) - https://www.last.fm/api
LASTFM_API_KEY=
LASTFM_API_SECRET=

# MusicBrainz requires a descriptive User-Agent with contact info
MUSICBRAINZ_USER_AGENT=Meridian/0.1 (your-email@example.com)
